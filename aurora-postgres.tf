# Aurora PostgreSQL Serverless v2 for the Orders service

resource "aws_security_group" "orders_db" {
  name        = "${var.project_name}-orders-db-sg"
  description = "PostgreSQL access for Orders, only from the EKS cluster"
  vpc_id      = aws_vpc.main.id

  # DevSecOps: only the EKS cluster SG may connect (not the whole VPC)
  ingress {
    description     = "PostgreSQL from EKS pods"
    from_port       = 5432
    to_port         = 5432
    protocol        = "tcp"
    security_groups = [module.eks.cluster_primary_security_group_id]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name        = "${var.project_name}-orders-db-sg"
    environment = "prod"
    component   = "apps"
  }
}

resource "aws_rds_cluster" "orders" {
  cluster_identifier = "${var.project_name}-orders-pg"
  engine             = "aurora-postgresql"
  engine_mode        = "provisioned"
  engine_version     = var.orders_db_engine_version
  database_name      = "orders"
  master_username    = "orders"

  # Password is generated by AWS in Secrets Manager, never stored in tfstate or Git
  manage_master_user_password = true

  db_subnet_group_name   = aws_db_subnet_group.aurora.name # reuse existing database subnets
  vpc_security_group_ids = [aws_security_group.orders_db.id]
  storage_encrypted      = true

  serverlessv2_scaling_configuration {
    min_capacity = 0.5
    max_capacity = 2
  }

  enabled_cloudwatch_logs_exports = ["postgresql"]

  backup_retention_period = 1
  deletion_protection     = false
  skip_final_snapshot     = true
  apply_immediately       = true

  tags = {
    Name        = "${var.project_name}-orders-pg"
    environment = "prod"
    component   = "apps"
  }
}

resource "aws_rds_cluster_instance" "orders" {
  identifier          = "${var.project_name}-orders-pg-1"
  cluster_identifier  = aws_rds_cluster.orders.id
  instance_class      = "db.serverless"
  engine              = aws_rds_cluster.orders.engine
  engine_version      = aws_rds_cluster.orders.engine_version
  publicly_accessible = false
  apply_immediately   = true

  tags = {
    Name        = "${var.project_name}-orders-pg-1"
    environment = "prod"
    component   = "apps"
  }
}

output "orders_db_endpoint" {
  value = aws_rds_cluster.orders.endpoint
}

output "orders_db_secret_arn" {
  value = aws_rds_cluster.orders.master_user_secret[0].secret_arn
}

# --- External Secrets Operator: read-only access to the orders DB secret ---

# IAM role that ESO's pod will use (via EKS Pod Identity - no access keys)
resource "aws_iam_role" "eso" {
  name               = "${var.project_name}-eso-role"
  assume_role_policy = data.aws_iam_policy_document.orders_pod_trust.json # same "pods.eks.amazonaws.com" trust as orders
}

# Least privilege: ESO may read ONLY the orders DB secret, nothing else
resource "aws_iam_role_policy" "eso_read_orders_db" {
  name = "${var.project_name}-eso-read-orders-db"
  role = aws_iam_role.eso.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["secretsmanager:GetSecretValue", "secretsmanager:DescribeSecret"]
      Resource = aws_rds_cluster.orders.master_user_secret[0].secret_arn
    }]
  })
}

# Link the role to ESO's Kubernetes service account
resource "aws_eks_pod_identity_association" "eso" {
  cluster_name    = module.eks.cluster_name
  namespace       = "external-secrets"
  service_account = "external-secrets"
  role_arn        = aws_iam_role.eso.arn
}