# =====================================================================
# STAGING copies of the Orders / Checkout / SQS backing services.
#
# Same design as prod (aurora-postgres.tf, elasticache.tf, sqs.tf), with a
# "-staging" name suffix, so staging can never read or write prod data:
#   - Aurora PostgreSQL  : group2-capstone-orders-pg-staging
#   - Valkey (checkout)  : group2-capstone-checkout-staging
#   - SQS queue          : group2-capstone-orders-events-staging
#   - IAM role (orders)  : can send ONLY to the staging queue, ONLY for
#                          pods in the retail-staging namespace
#
# Kept in its own file so it does not touch the prod files.
# =====================================================================

locals {
  staging_namespace = "retail-staging" # same namespace as Eugene's ui-staging
}

# ---------------------------------------------------------------------
# 1. Aurora PostgreSQL Serverless v2 (orders-staging)
# ---------------------------------------------------------------------
resource "aws_security_group" "orders_db_staging" {
  name        = "${var.project_name}-orders-db-staging-sg"
  description = "PostgreSQL access for Orders (staging), only from the EKS cluster"
  vpc_id      = aws_vpc.main.id

  ingress {
    description     = "PostgreSQL from EKS pods"
    from_port       = 5432
    to_port         = 5432
    protocol        = "tcp"
    security_groups = [module.eks.cluster_primary_security_group_id]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name        = "${var.project_name}-orders-db-staging-sg"
    environment = "staging"
    component   = "apps"
  }
}

resource "aws_rds_cluster" "orders_staging" {
  cluster_identifier = "${var.project_name}-orders-pg-staging"
  engine             = "aurora-postgresql"
  engine_mode        = "provisioned"
  engine_version     = var.orders_db_engine_version
  database_name      = "orders"
  master_username    = "orders"

  # Password generated by AWS in Secrets Manager (a DIFFERENT secret from prod)
  manage_master_user_password = true

  db_subnet_group_name   = aws_db_subnet_group.aurora.name
  vpc_security_group_ids = [aws_security_group.orders_db_staging.id]
  storage_encrypted      = true

  serverlessv2_scaling_configuration {
    min_capacity = 0.5
    max_capacity = 1 # staging: smaller cap than prod (2) to save cost
  }

  backup_retention_period = 1
  deletion_protection     = false
  skip_final_snapshot     = true
  apply_immediately       = true

  tags = {
    Name        = "${var.project_name}-orders-pg-staging"
    environment = "staging"
    component   = "apps"
  }
}

resource "aws_rds_cluster_instance" "orders_staging" {
  identifier          = "${var.project_name}-orders-pg-staging-1"
  cluster_identifier  = aws_rds_cluster.orders_staging.id
  instance_class      = "db.serverless"
  engine              = aws_rds_cluster.orders_staging.engine
  engine_version      = aws_rds_cluster.orders_staging.engine_version
  publicly_accessible = false
  apply_immediately   = true

  tags = {
    Name        = "${var.project_name}-orders-pg-staging-1"
    environment = "staging"
    component   = "apps"
  }
}

# ESO (same role as prod) may also READ the staging DB secret, and nothing else new.
# ListSecrets/BatchGetSecretValue are already granted in aurora-postgres.tf.
resource "aws_iam_role_policy" "eso_read_orders_db_staging" {
  name = "${var.project_name}-eso-read-orders-db-staging"
  role = aws_iam_role.eso.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid      = "ReadOrdersDbStagingSecretOnly"
        Effect   = "Allow"
        Action   = ["secretsmanager:GetSecretValue", "secretsmanager:DescribeSecret"]
        Resource = aws_rds_cluster.orders_staging.master_user_secret[0].secret_arn
      }
    ]
  })
}

# ---------------------------------------------------------------------
# 2. ElastiCache Serverless Valkey (checkout-staging)
# ---------------------------------------------------------------------
resource "aws_security_group" "checkout_cache_staging" {
  name        = "${var.project_name}-checkout-cache-staging-sg"
  description = "Valkey access to the checkout-staging cache from within the VPC"
  vpc_id      = aws_vpc.main.id

  ingress {
    description = "Valkey (read/write + reader) from VPC"
    from_port   = 6379
    to_port     = 6380
    protocol    = "tcp"
    cidr_blocks = [var.vpc_cidr]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name        = "${var.project_name}-checkout-cache-staging-sg"
    environment = "staging"
    component   = "apps"
  }
}

resource "aws_elasticache_serverless_cache" "checkout_staging" {
  name                 = "${var.project_name}-checkout-staging"
  description          = "Checkout session store - STAGING (Valkey Serverless)"
  engine               = "valkey"
  major_engine_version = "8"

  subnet_ids         = aws_subnet.private[*].id
  security_group_ids = [aws_security_group.checkout_cache_staging.id]

  cache_usage_limits {
    data_storage {
      maximum = 1 # staging: 1 GB cap (prod: 5 GB)
      unit    = "GB"
    }
    ecpu_per_second {
      maximum = 10000 # staging: lower cost cap than prod
    }
  }

  snapshot_retention_limit = 0 # staging: no backups needed

  tags = {
    Name        = "${var.project_name}-checkout-staging"
    environment = "staging"
    component   = "apps"
  }
}

# ---------------------------------------------------------------------
# 3. SQS queue + least-privilege Pod Identity role (orders-staging)
# ---------------------------------------------------------------------
resource "aws_sqs_queue" "orders_events_staging" {
  name                       = "${var.project_name}-orders-events-staging"
  message_retention_seconds  = 86400
  visibility_timeout_seconds = 30
  sqs_managed_sse_enabled    = true

  tags = {
    Environment = "staging"
    ManagedBy   = "Terraform"
  }
}

# Separate role from prod: a staging pod can never send to the prod queue
resource "aws_iam_role" "orders_pod_staging" {
  name               = "${var.project_name}-orders-pod-staging-role"
  assume_role_policy = data.aws_iam_policy_document.orders_pod_trust.json # same Pod Identity trust as prod
}

resource "aws_iam_role_policy" "orders_sqs_send_staging" {
  name = "${var.project_name}-orders-sqs-send-staging"
  role = aws_iam_role.orders_pod_staging.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid      = "SendStagingOrderEventsOnly"
        Effect   = "Allow"
        Action   = ["sqs:SendMessage", "sqs:GetQueueUrl", "sqs:GetQueueAttributes"]
        Resource = aws_sqs_queue.orders_events_staging.arn
      }
    ]
  })
}

# Pods using service account "orders" in retail-staging get the STAGING role
resource "aws_eks_pod_identity_association" "orders_staging" {
  cluster_name    = module.eks.cluster_name
  namespace       = local.staging_namespace
  service_account = "orders"
  role_arn        = aws_iam_role.orders_pod_staging.arn
}

# ---------------------------------------------------------------------
# Outputs: copy these into the gitops/app/apps/*-staging.yaml files
# ---------------------------------------------------------------------
output "orders_db_staging_endpoint" {
  description = "Set as app.persistence.endpoint (add :5432) in orders-staging.yaml"
  value       = aws_rds_cluster.orders_staging.endpoint
}

output "checkout_cache_staging_endpoint" {
  description = "Set as app.persistence.redis.endpoint in checkout-staging.yaml"
  value       = "${aws_elasticache_serverless_cache.checkout_staging.endpoint[0].address}:${aws_elasticache_serverless_cache.checkout_staging.endpoint[0].port}"
}

output "orders_events_staging_queue_name" {
  description = "Set as app.messaging.sqs.topic in orders-staging.yaml"
  value       = aws_sqs_queue.orders_events_staging.name
}
